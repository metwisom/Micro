# EditorConfig — https://editorconfig.org
# Matches what the repository already uses: spaces everywhere, LF, UTF-8.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Android server: Kotlin, Gradle build scripts, resources and ProGuard rules.
[*.{kt,kts,java,xml,pro}]
indent_size = 4

# Desktop client: Rust.
[*.rs]
indent_size = 4

# Windows build script.
[*.ps1]
indent_size = 4

# Frontend, configuration and shell scripts.
[*.{js,mjs,cjs,css,html,json,yml,yaml,sh}]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break, so leave them alone.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Batch files are CRLF or cmd.exe misparses them.
[*.bat]
end_of_line = crlf
