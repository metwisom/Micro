{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Micro",
  "version": "2.0.0",
  "identifier": "ru.metwisom.micro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Micro",
        "width": 500,
        "height": 300,
        "minWidth": 500,
        "maxWidth": 500,
        "minHeight": 200,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": ["icons/icon.png"]
  }
}
